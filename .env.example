# Optional product image uploads (server-only secrets).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Copy to .env and replace both values using the Neon Connect dialog.
# Application: pooled URL (hostname contains -pooler).
DATABASE_URL="postgresql://USER:PASSWORD@ep-EXAMPLE-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Prisma migrations: direct URL for the SAME Neon database and branch.
DIRECT_URL="postgresql://USER:PASSWORD@ep-EXAMPLE.REGION.aws.neon.tech/neondb?sslmode=require"

# Random secret for encrypted NextAuth sessions; keep the real value out of Git.
AUTH_SECRET=""
# Set AUTH_URL to the canonical HTTPS origin when deploying.
# AUTH_URL="https://your-domain.example"
# For self-hosting behind a trusted reverse proxy that sets forwarded headers:
# AUTH_TRUST_HOST=true
# Set these in the hosting platform's runtime environment too; local .env is not deployed automatically.

# Password recovery: AUTH_URL above must be the canonical HTTPS origin.
# Use your provider's verified sender. Secrets remain server-only.
# Setup steps and a Resend SMTP example: docs/smtp-setup.md
# After configuration: npm run smtp:verify (connects without sending email).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Signup OTP only: official Kavenegar VerifyLookup SDK.
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=acoffeeverify
# Generate a separate random secret (at least 32 characters); keep it on the server.
OTP_SECRET=

# Dedicated, empty Neon test branch only. Never copy the main endpoint here.
# db:prepare:test applies migrations and creates deterministic test fixtures.
TEST_DATABASE_URL=
TEST_DIRECT_URL=
