# Copy to .env and replace both values using the Neon Connect dialog.
# Application: pooled URL (hostname contains -pooler).
DATABASE_URL="postgresql://USER:PASSWORD@ep-EXAMPLE-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Prisma migrations: direct URL for the SAME Neon database and branch.
DIRECT_URL="postgresql://USER:PASSWORD@ep-EXAMPLE.REGION.aws.neon.tech/neondb?sslmode=require"

# Random secret for encrypted NextAuth sessions; keep the real value out of Git.
AUTH_SECRET=""
# Set AUTH_URL to the canonical HTTPS origin when deploying.
# AUTH_URL="https://your-domain.example"
