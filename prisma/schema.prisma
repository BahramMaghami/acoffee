generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

/// Persistent per-identity throttling for Credentials login and registration.
model AuthRateLimit {
  key      String   @id @db.VarChar(64)
  attempts Int      @default(1)
  resetsAt DateTime @db.Timestamptz(3)

  @@index([resetsAt])
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

enum GrindOption {
  WHOLE_BEAN
  GROUND
}

enum GrindDevice {
  MOKA_POT
  HOME_ESPRESSO
  SEMI_COMMERCIAL
  COMMERCIAL
}

enum ShippingMethod {
  POST
  TIPAX
  COURIER
  PICKUP
}

model User {
  id           String    @id @default(cuid())
  name         String    @db.VarChar(100)
  /// Normalize email to lowercase and trim before every lookup/write.
  email        String    @unique @db.VarChar(254)
  passwordHash String    @db.VarChar(255)
  phone        String?   @db.VarChar(11)
  phoneVerifiedAt DateTime? @db.Timestamptz(3)
  sessionVersion Int     @default(0)
  passwordResetTokens PasswordResetToken[]
  accountPhoneOtp AccountPhoneOtp?
  role         Role      @default(CUSTOMER)
  addresses    Address[]
  orders       Order[]
  cart         Cart?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  @@index([phone])
}

/// One pending signup per email; a phone can belong to multiple users.
model SignupOtp {
  id        String @id
  email     String @unique @db.VarChar(254)
  phone     String @db.VarChar(11)
  codeHash  String @db.VarChar(64)
  attempts  Int @default(0)
  sentAt    DateTime? @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([expiresAt])
}

/// First verified phone only. Challenges are bound to the authenticated session version.
model AccountPhoneOtp {
  id String @id
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone String @db.VarChar(11)
  sessionVersion Int
  codeHash String @db.VarChar(64)
  attempts Int @default(0)
  sentAt DateTime? @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([expiresAt])
}

model PasswordResetToken {
  tokenHash String   @id @db.VarChar(64)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientName String   @db.VarChar(100)
  phone         String   @db.VarChar(20)
  province      String   @db.VarChar(100)
  city          String   @db.VarChar(100)
  addressLine   String   @db.VarChar(500)
  postalCode    String   @db.VarChar(10)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

// Import receipts prevent a repeated seed from recreating products deleted by an admin.
model CatalogImport {
  slug String @id @db.VarChar(100)
}

model Category {
  id            String @id @default(cuid())
  slug          String @unique @db.VarChar(100)
  name          String @unique @db.VarChar(100)
  sortOrder     Int @default(0)
  defaultWeights Int[]
  defaultRoasts String[]
  defaultGrades String[]
  wholesale     Boolean @default(false)
  products      CatalogProduct[]
}

model CatalogProduct {
  id          String @id @default(cuid())
  slug        String @unique @db.VarChar(100)
  name        String @db.VarChar(150)
  description String @db.Text
  origin      String @default("")
  cafeGroup   String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  weights     Int[]
  roasts      String[]
  grades      String[]
  basePrices  Json @default("{}")
  imageUrl    String?
  imagePublicId String? @unique
  isActive    Boolean @default(true)
  sortOrder   Int @default(0)
  variants    Product[]
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([categoryId, sortOrder])
  @@index([isActive, createdAt])
}

model Product {
  id          String      @id @default(cuid())
  name        String      @db.VarChar(150)
  slug        String      @unique @db.VarChar(200)
  description String      @db.Text
  /// All money fields store whole toman; never use floating-point arithmetic.
  price       Decimal?    @db.Decimal(14, 0)
  /// Optional reference price for an actual discount; price remains the payable amount.
  originalPrice Decimal?  @db.Decimal(14, 0)
  catalogProductId String?
  catalogProduct CatalogProduct? @relation(fields: [catalogProductId], references: [id], onDelete: Cascade)
  roast       String @default("default")
  grade       String @default("standard")
  manualPrice Boolean @default(false)
  discountPercent Int @default(0)
  weightGrams Int
  /// Available preparations; these do not change SKU identity or price.
  grindOptions GrindOption[] @default([WHOLE_BEAN, GROUND])
  imageUrl    String?     @db.Text
  isActive    Boolean     @default(true)
  cartItems   CartItem[]
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)

  @@index([isActive, createdAt])
  @@unique([catalogProductId, weightGrams, roast, grade])
}

model Cart {
  id             String     @id @default(cuid())
  checkoutKey    String     @unique @default(dbgenerated("gen_random_uuid()::text")) @db.VarChar(36)
  userId         String?    @unique
  user           User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Exactly one owner: a user or the hash of a random guest cookie token.
  guestTokenHash String?    @unique @db.VarChar(64)
  /// Required for guest carts; enforced in the SQL migration.
  expiresAt      DateTime?  @db.Timestamptz(3)
  items          CartItem[]
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)

  @@index([expiresAt])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  /// Null for pre-feature carts: the customer must explicitly choose before checkout.
  grind     GrindOption?
  /// Required for new ground-coffee checkouts; null for legacy carts and whole beans.
  grindDevice GrindDevice?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([cartId, productId, grind, grindDevice])
  @@index([productId])
}

model Order {
  id            String        @id @default(cuid())
  checkoutKey   String?       @unique @db.VarChar(36)
  number        Int           @unique @default(autoincrement())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  /// Amounts are calculated on the server from current product prices.
  subtotal      Decimal       @db.Decimal(14, 0)
  shippingFee   Decimal       @default(0) @db.Decimal(14, 0)
  shippingFeeFinalized Boolean @default(false)
  /// Null only for historical orders; new orders require an explicit choice.
  shippingMethod ShippingMethod?
  discount      Decimal       @default(0) @db.Decimal(14, 0)
  total         Decimal       @db.Decimal(14, 0)
  /// Shipping snapshot, independent of the user's editable address book.
  recipientName String        @db.VarChar(100)
  phone         String        @db.VarChar(20)
  province      String        @db.VarChar(100)
  city          String        @db.VarChar(100)
  addressLine   String        @db.VarChar(500)
  postalCode    String        @db.VarChar(10)
  items         OrderItem[]
  paidAt        DateTime?     @db.Timestamptz(3)
  deliveredAt   DateTime?     @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Immutable product snapshots preserve order history after product edits/deletion.
  productName String   @db.VarChar(150)
  productSlug String   @db.VarChar(200)
  weightGrams Int
  /// Immutable preparation snapshot; null for historical orders.
  grind       GrindOption?
  /// Immutable device snapshot; null for historical orders and whole beans.
  grindDevice GrindDevice?
  unitPrice   Decimal  @db.Decimal(14, 0)
  quantity    Int
  lineTotal   Decimal  @db.Decimal(14, 0)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([orderId])
  @@index([productId])
}
